# =============================================================================
# LendLoop Environment Configuration (.env.example)
# Copy to .env.local (for Next.js) and .env (for Docker Compose / n8n).
# NEVER commit real secrets to git.
# =============================================================================

# --- Clerk Authentication (leave blank to run in Local Demo Mode) ------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk JWT Issuer Domain (used by convex/auth.config.ts, e.g. https://your-app.clerk.accounts.dev)
CLERK_JWT_ISSUER_DOMAIN=

# --- Convex Backend (leave blank to run in Local Demo Mode) ------------------
NEXT_PUBLIC_CONVEX_URL=
# Convex HTTP Actions URL (e.g. https://your-deployment.convex.site)
# In Local Demo Mode, point n8n to http://host.docker.internal:3000
CONVEX_SITE_URL=http://host.docker.internal:3000

# --- Shared HMAC-SHA256 Automation Secret (Convex <-> n8n) -------------------
# Generate with: openssl rand -hex 32
# Must match in Convex env (`npx convex env set LENDLOOP_HMAC_SECRET ...`),
# Next.js `.env.local`, and n8n Docker `.env`.
LENDLOOP_HMAC_SECRET=replace-with-32-byte-random-hex-secret

# --- Outbound Webhook Targets (Convex -> n8n & n8n -> Notification/Alert) ----
# n8n webhook URL for borrow request creation & status-change events (Convex env var)
N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-loan-events

# Notification delivery sink for n8n (e.g. Slack/Discord/Mailgun/Webhook.site)
NOTIFICATION_SINK_URL=https://httpbin.org/post

# Operations failure alert webhook for n8n Error Workflow (Slack/PagerDuty/etc.)
ALERT_WEBHOOK_URL=https://httpbin.org/post

# --- Self-Hosted n8n Docker Configuration ------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_TIMEZONE=UTC
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-32-byte-random-encryption-key
